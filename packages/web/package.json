{
  "name": "@roamcode.ai/web",
  "version": "4.0.48",
  "description": "Installable control center for RoamCode Sessions",
  "homepage": "https://roamcode.ai",
  "bugs": "https://github.com/burakgon/roamcode/issues",
  "type": "module",
  "files": [
    "dist"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "coding-agent",
    "self-hosted",
    "terminal",
    "pwa"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/burakgon/roamcode.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
